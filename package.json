{
  "name": "work-dashboard-desktop",
  "productName": "Work Dashboard",
  "version": "0.1.2",
  "description": "Desktop window for the Work Dashboard.",
  "author": "The Creator Factory",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.creatorfactory.workdashboard",
    "files": ["main.js", "config.json"],
    "afterPack": "build/after-pack.js",
    "publish": [{ "provider": "github", "owner": "SunnyTCF", "repo": "work-dashboard-app" }],
    "win": { "target": "nsis" },
    "nsis": { "artifactName": "Work-Dashboard-Setup-${version}.${ext}" },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "Work-Dashboard-${version}-mac-${arch}.${ext}",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    }
  }
}
